<%
  # 引用元の本文・メディア・さらに先の引用(入れ子にせずリンクだけ)
  # パラメータ: quoted(引用元の投稿)、link_target(任意)
  link_target = local_assigns[:link_target]
  media = quoted.media_attachments.to_a.first(4)
  nested = quoted.quote_posts.first&.quoted_object
%>
<% if quoted.content.present? %>
  <div style="font-size: 15px; line-height: 1.6; color: #374151; white-space: pre-wrap; overflow-wrap: anywhere;"><%= parse_content_for_frontend(content_without_quote_fallback(quoted), domain: quoted.actor&.domain).html_safe %></div>
<% end %>
<% if media.any? %>
  <div style="display: grid; grid-template-columns: repeat(<%= media.size == 1 ? 1 : 2 %>, minmax(0, 1fr)); gap: 8px;">
    <% media.each do |attachment| %>
      <a href="<%= safe_external_url(attachment.url) %>" target="_blank" rel="noopener noreferrer" style="display: block; height: 160px; background: #e5e7eb; overflow: hidden;">
        <% if attachment.preview_url.present? %>
          <img src="<%= attachment.preview_url %>" alt="<%= attachment.description %>" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
        <% else %>
          <span style="display: flex; height: 100%; align-items: center; justify-content: center; font-size: 13px; color: #4b5563;"><%= attachment.video? ? '動画' : 'ファイル' %></span>
        <% end %>
      </a>
    <% end %>
  </div>
<% end %>
<% if nested %>
  <%= link_to "さらに別の投稿(#{actor_handle(nested.actor)})を引用しています", quoted_post_url(nested),
              style: 'font-size: 13px; font-weight: 300; color: #6b7280;',
              target: link_target, rel: (link_target && 'noopener'), data: { turbo_frame: '_top' } %>
<% end %>
