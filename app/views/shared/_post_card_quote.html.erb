<%
  # 引用元の投稿を、投稿カードの中の細い枠で表示する
  # パラメータ: post(引用した投稿)、link_target(任意。埋め込み表示では'_blank'で別タブに開く)
  link_target = local_assigns[:link_target]
  quote_post = post.quote_posts.first
  quoted = quote_post&.quoted_object
%>
<% if quoted %>
  <div class="post-card-quote" style="margin-top: 12px; border: 1px solid #e5e7eb; padding: 16px; display: flex; flex-direction: column; gap: 8px;">
    <% if quoted.publicly_accessible? %>
      <% quoted_actor = quoted.actor %>
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 14px; font-weight: 300;">
        <div style="width: 24px; height: 24px; background: #6b7280; color: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; font-size: 11px; font-weight: 500; flex-shrink: 0;">
          <% if quoted_actor.avatar_url.present? %>
            <img src="<%= quoted_actor.avatar_url %>" alt="" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
          <% else %>
            <%= (quoted_actor.display_name.presence || quoted_actor.username).first.upcase %>
          <% end %>
        </div>
        <%= link_to quoted_actor_url(quoted_actor), class: 'post-card-username-link', style: 'color: #111827;',
                    target: link_target, rel: (link_target && 'noopener'), data: { turbo_frame: '_top' } do %>
          <%= parse_content_for_frontend(quoted_actor.display_name.presence || quoted_actor.username, domain: quoted_actor.domain).html_safe %>
        <% end %>
        <span style="color: #6b7280; overflow-wrap: anywhere;"><%= actor_handle(quoted_actor) %></span>
        <%= link_to quoted_post_url(quoted), class: 'post-card-time-link', style: 'margin-left: auto; color: #6b7280;',
                    target: link_target, rel: (link_target && 'noopener'), data: { turbo_frame: '_top' } do %>
          <time datetime="<%= quoted.published_at.iso8601 %>"><%= l(quoted.published_at, format: :long) %></time>
        <% end %>
      </div>
      <% if quoted.summary.present? %>
        <details>
          <summary style="cursor: pointer; font-size: 15px; color: #374151;">
            <%= quoted.summary %>
            <span style="margin-left: 8px; font-size: 13px; font-weight: 300; border: 1px solid #d1d5db; padding: 2px 10px;">続きを読む</span>
          </summary>
          <div style="margin-top: 8px; display: flex; flex-direction: column; gap: 8px;">
            <%= render 'shared/post_card_quote_body', quoted: quoted, link_target: link_target %>
          </div>
        </details>
      <% else %>
        <%= render 'shared/post_card_quote_body', quoted: quoted, link_target: link_target %>
      <% end %>
    <% else %>
      <div style="font-size: 14px; font-weight: 300; color: #6b7280;">引用元の投稿は公開範囲の設定で表示できません。</div>
    <% end %>
  </div>
  <% if quote_post.awaiting_approval? %>
    <div style="margin-top: 8px; font-size: 13px; font-weight: 300; color: #6b7280;">引用元の作者の承認待ち</div>
  <% end %>
<% end %>
